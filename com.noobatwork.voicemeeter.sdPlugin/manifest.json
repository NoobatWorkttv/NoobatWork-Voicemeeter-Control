{
  "UUID": "com.noobatwork.voicemeeter",
  "Name": "NoobatWork Voicemeeter Control",
  "Category": "NoobatWork Voicemeeter",
  "Author": "NoobatWork",
  "Description": "Voicemeeter live faders plus auto-discovered per-app WASAPI volume and mute",
  "Version": "0.5.0.0",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "Nodejs": {
    "Version": "24"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "CodePath": "plugin.js",
  "Actions": [
    {
      "UUID": "com.noobatwork.voicemeeter.fader",
      "Name": "Live-Fader",
      "Tooltip": "Gain display and mute toggle",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.noobatwork.voicemeeter.up",
      "Name": "Lauter",
      "Tooltip": "Increase gain",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.noobatwork.voicemeeter.down",
      "Name": "Leiser",
      "Tooltip": "Decrease gain",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.noobatwork.voicemeeter.segment",
      "Name": "Touch-Fader · Segment",
      "Tooltip": "Set gain to a configured five-key segment; set positions 1–5 in the inspector",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.noobatwork.voicemeeter.mute",
      "Name": "Mute",
      "Tooltip": "Toggle mute for selected Voicemeeter strip or bus",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.noobatwork.voicemeeter.compact",
      "Name": "Kompakt-Mixer",
      "Tooltip": "Eine Taste pro Kanal: Tippen lauter, Halten leiser, doppelt Tippen Mute",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.noobatwork.voicemeeter.app",
      "Name": "App-Mixer",
      "Tooltip": "Windows-Audioanwendungen erkennen, Lautstärke individuell regeln und stummschalten",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    }
  ],
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Icon": "imgs/plugin",
  "CategoryIcon": "imgs/category",
  "PropertyInspectorPath": "settings.html"
}
